{
  "build": {
    "arduino": {
      "ldscript": "nrf51_xxaa.ld"
    },
    "core": "nRF5",
    "cpu": "cortex-m0",
    "extra_flags": "-DARDUINO_BBC_MICROBIT -DUSE_LFRC",
    "f_cpu": "16000000L",
    "mcu": "nrf51822",
    "variant": "BBCmicrobit",
    "zephyr": {
      "variant": "bbc_microbit"
    }
  },
  "connectivity": [
    "bluetooth"
  ],
  "debug": {
    "svd_path": "nrf51.svd",
    "jlink_device": "nRF51822_xxAA"
  },
  "frameworks": [
    "arduino",
    "zephyr"
  ],
  "name": "BBC micro:bit (ST-Link)",
  "upload": {
    "maximum_ram_size": 16384,
    "maximum_size": 262144,
    "protocol": "stlink",
    "protocols": [
      "cmsis-dap",
      "jlink",
      "stlink"
    ]
  },
  "url": "https://microbit.org/",
  "vendor": "BBC"
}
